@@ -1866,11 +1866,13 @@ inline void default_socket_options(socket_t sock) {
   setsockopt(sock, SOL_SOCKET, SO_EXCLUSIVEADDRUSE,
              reinterpret_cast<const char *>(&yes), sizeof(yes));
